<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\MementoMori\MementoMori.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\MementoMori.Common\MementoMori.Common.csproj" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\..\MementoMori.Ortega\MementoMori.Ortega.csproj" />
    <Compile Include="../../MementoMori.Exporter.Android/Services/CredentialImport.cs" Link="CredentialImport.cs" />
    <Compile Include="../../MementoMori.Exporter.Android/Services/MemoryOptions.cs" Link="MemoryOptions.cs" />
    <Compile Include="../../MementoMori.Exporter.Android/Services/MobileSnapshot.cs" Link="MobileSnapshot.cs" />
    <Compile Include="../../MementoMori.Exporter.Android/Services/ExportFileStore.cs" Link="ExportFileStore.cs" />
    <Compile Include="../../MementoMori.Exporter.Android/Services/SavedCredentials.cs" Link="SavedCredentials.cs" />
  </ItemGroup>
  <Target Name="ValidateProtocolReferences" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('%(ProjectReference.Identity)')" Text="Required protocol project not found: %(ProjectReference.Identity)" />
  </Target>
</Project>
